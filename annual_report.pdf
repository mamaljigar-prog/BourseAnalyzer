    <script id="myScript" type="text/javascript">
        function fixColspan(cellElement, colSpan, isToPrint) {
            // IE7 in non-print mode
            if ($.browser.msie && parseInt($.browser.version) == 7 && isToPrint == false) {
                var dir = $('body').css("direction");
                cellHeight = cellElement.height();
                // Wrap cellElement.text() into a custom span
                var spanCaption = $('<span id="span' + cellElement.attr('class').split(' ')[0] +
                    '" style="position: absolute; color: white;" class="noWrap">' +
                    cellElement.text() + '</span>');
                cellElement.css({ 'height': cellHeight, 'verticalAlign': 'middle' });
                // Wrap created span into cellElement
                cellElement.html(spanCaption);
                // Calculate width, height and top position of text
                var textWidth = cellElement.find('span:first').width();
                var textHeight = cellElement.find('span:first').height();
                var top = cellElement.find('span:first').position().top;

                var totalWidth = cellElement.width();
                var currentCell = cellElement;

                for (i = 0; i < colSpan - 1; i++) {
                    nextCell = currentCell.next();
                    totalWidth += nextCell.width();

                    strBorder = "borderRight";
                    if (dir != "rtl")
                        strBorder = "borderLeft";

                    nextCell.css(strBorder, "solid 1px #007ec8");
                    currentCell.text("");
                    cellElement.closest('table').before(spanCaption);

                    currentCell = nextCell;
                }

                if (dir == "rtl") {
                    $('#span' + cellElement.attr("class").split(' ')[0]).css({
                        'top': top + cellElement.height() / 2 - textHeight / 2,
                        'left': currentCell.position().left + (totalWidth - textWidth) / 2
                    });

                    $('.ui-tinytbl-tb-right').scroll(function () {
                        $('#span' + cellElement.attr("class").split(' ')[0]).css({
                            'top': top + cellElement.height() / 2 - textHeight / 2,
                            'left': currentCell.position().left + (totalWidth - textWidth) / 2
                        });
                    });
                }
                // dir == "ltr" or null
                else {
                    $('#span' + cellElement.attr("class").split(' ')[0]).css({
                        'top': top + cellElement.height() / 2 - textHeight / 2,
                        'left': cellElement.position().left + (totalWidth - textWidth) / 2
                    });

                    $('.ui-tinytbl-tb-right').scroll(function () {
                        $('#span' + cellElement.attr("class").split(' ')[0]).css({
                            'top': top + cellElement.height() / 2 - textHeight / 2,
                            'left': cellElement.position().left + (totalWidth - textWidth) / 2
                        });
                    });
                }
            }
            // All browsers but IE7 in non-print mode
            else {
                cellElement.attr("colspan", colSpan);
                for (i = 0; i < colSpan - 1; i++) {
                    cellElement.next().remove();
                }
            }
        }

        // Creates a new window popup to print copy
        function printPopup(htmlData, printTitle) {
            var w = window.open('', 'ToPrint', 'width=' + screen.width + ', height=' + screen.height + ', top=' + screen.height / 2 + ' , left=' + screen.width / 2 + ', fullscreen=yes');
            var html = '<html dir="' + $("body").css("direction") + '">\n' +
                '<head>\n' +
                '   <title>' + printTitle + '</title>\n' +
                '   <style>\n' +
                '      th { border-top: solid 1px black; border-bottom: solid 1px black; }\n' +
                '      td { border-top: solid 1px sliver; border-bottom: solid 1px silver; }\n' +
                '      .GridAlternating { background-color: silver; }\n' +
                '      .GridFooter { font-size: 9pt; }\n' +
                '   </style>\n' +
                '</head>\n' +
                '<body style="font-family: tahoma; font-size: 10pt;" onload="window.focus(); window.print(); window.close();">\n' +
                htmlData +
                '\n</body>\n</html>';

            w.document.write(html);
            w.document.close();

            return true;
        }

        function getGridHeight(maxHeight, gridId) {
            var calcHeight = 0;

            if (document.getElementById(gridId) != null &&
                document.getElementById(gridId) != "undefined") {
                calcHeight = maxHeight;
                var scrollHeight = 20;

                if (bowser.firefox)
                    scrollHeight = 30;

                var gridHeight = document.getElementById(gridId).clientHeight;

                if (gridHeight < maxHeight) {
                    calcHeight = gridHeight + scrollHeight;
                }
            }

            return calcHeight;
        }
    </script>

    

