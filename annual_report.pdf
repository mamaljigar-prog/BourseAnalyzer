            else
                document.getElementById("ctl00_ddlTable").selectedIndex = 0;
        }

        function btnPrevClick() {
            if (document.getElementById("ctl00_ddlTable").selectedIndex > 0)
                document.getElementById("ctl00_ddlTable").selectedIndex -= 1;
            else
                document.getElementById("ctl00_ddlTable").selectedIndex = document.getElementById("ctl00_ddlTable").length - 1;
        }

